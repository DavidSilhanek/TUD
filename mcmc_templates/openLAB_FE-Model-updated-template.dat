+PROG SOFIMSHC URS:2
KOPF System Generation
SYST 3D GDIV 100000 GDIR POSZ
ECHO GEOM EXTR
ECHO SYST EXTR
STEU TOPO GAXP 3 !Generation of structure points and structure lines along the main/secondary axis
STEU MESH 1      !Meshing of beam and plate elements
STEU HMIN .5     !max mesh size

!*!Label Beam elements

!Definition of the main axes span 1 and 2 - one axis for each T-beam
GAX A1 TYP LANE BEZ "Axis PE x.1"
 GAXA S 0 X 0 Y -#B_FT SX 1 SY 0 L #A30

GAX A2 TYP LANE BEZ "Axis PE x.2"
 GAXA S 0 X 0 Y  0 SX 1 SY 0  L #A30

GAX A3 TYP LANE BEZ "Axis PE x.3"
 GAXA S 0 X 0 Y #B_FT SX 1 SY 0  L #A30


!Definition of Placements along bridge axes
!*!Label PE x.1 - GRP 10,11,41,21
 GAXP A1 IDS 0 S   #A10                 TYP 'S' GRP 10 NRQ       111 SPT 1100 IDP A10   !Axis 10
 GAXP A1 IDS 0 S   #A10+0.225                   GRP 10 NRQ       111 SPT 1110           !Support
 GAXP A1 IDS 0 S   #A10+2                       GRP 10 NRQ       112 SPT 1120           !Change in reinforcement
 GAXP A1 IDS 0 S   #A20-4               TYP 'J' GRP 11 NRQ       112 SPT 1140           BEZ 'G_NGSX_FT11_BU1100_0+G_NGSY_FT11_BU1100_0' !Coupling joint/Tiltmeter    G_NGSX/Y_FT11_BU1100_0
 GAXP A1 IDS 0 S   #A20-2.6                     GRP 11 NRQ       114 SPT 1170           !Change in reinforcement
 GAXP A1 IDS 0 S   #A20-0.1             TYP 'J' GRP 41 NRQ         1 SPT 1190           !Axis 20 Joint
 GAXP A1 IDS 0 S   #A20                 TYP 'S' GRP 41 NRQ         1 SPT 1200 IDP A20   !Axis 20
 GAXP A1 IDS 0 S   #A20+0.1             TYP 'J' GRP 21 NRQ       212 SPT 1210           !Axis 20 Joint
 GAXP A1 IDS 0 S   #A20+0.3                     GRP 21 NRQ       212 SPT 1220           !IEXB Sensor
 GAXP A1 IDS 0 S   #A20+2.6                     GRP 21 NRQ       213 SPT 1230           !Change in reinforcement
 GAXP A1 IDS 0 S   #A20+3.90                    GRP 21 NRQ       213 SPT 1240           !IEXB Sensor
 GAXP A1 IDS 0 S   #A20+4                       GRP 21 NRQ       213 SPT 1250           BEZ 'G_NGSX_FT21_BU0400_0+G_NGSY_FT21_BU0400_0' !Measuring point Tiltmeter
 GAXP A1 IDS 0 S   #A20+7.50                    GRP 21 NRQ       213 SPT 1260           !IEXB Sensor
 GAXP A1 IDS 0 S   24.3                         GRP 21 NRQ       213 SPT 1280           !Measuring point load test
 GAXP A1 IDS 0 S   #A30-3.90                    GRP 21 NRQ       213 SPT 1281           !IEXB Sensor
 GAXP A1 IDS 0 S   #A30-0.79                    GRP 21 NRQ       214 SPT 1290           !Change in reinforcement
 GAXP A1 IDS 0 S   #A30-0.30                    GRP 21 NRQ       214 SPT 1291           !IEXB Sensor
 GAXP A1 IDS 0 S   #A30                 TYP 'S' GRP 21               SPT 1300 IDP  A30  !Achse 30

!*!Label PE x.2 - GRP 12,42,22
 GAXP A2 IDS 0 S   #A10                 TYP 'S' GRP 12 NRQ       121 SPT 2100 IDP A10   !Axis 10
 GAXP A2 IDS 0 S   #A10+0.225                   GRP 12 NRQ       121 SPT 2110
 GAXP A2 IDS 0 S   #A10+2.0                     GRP 12 NRQ       122 SPT 2120           !Change in reinforcement
 GAXP A2 IDS 0 S   #A20-4.0                     GRP 12 NRQ       122 SPT 2140           BEZ 'G_NGSX_FT12_BU1100_0+G_NGSY_FT12_BU1100_0' !Measuring point Tiltmeter
 GAXP A2 IDS 0 S   #A20-2.6                     GRP 12 NRQ       124 SPT 2170           !Change in reinforcement
 GAXP A2 IDS 0 S   #A20-0.1             TYP 'J' GRP 42 NRQ         2 SPT 2190           !Axis 20 Joint
 GAXP A2 IDS 0 S   #A20                 TYP 'S' GRP 42 NRQ         2 SPT 2200 IDP A20   !Axis 20
 GAXP A2 IDS 0 S   #A20+0.1             TYP 'J' GRP 22 NRQ       222 SPT 2210           !Axis 20 Joint
 GAXP A2 IDS 0 S   #A20+0.3                     GRP 22 NRQ       222 SPT 2220           !IEXB Sensor
 GAXP A2 IDS 0 S   #A20+2.6                     GRP 22 NRQ       223 SPT 2230           !Change in reinforcement
 GAXP A2 IDS 0 S   #A20+3.90                    GRP 22 NRQ       223 SPT 2240           !IEXB Sensor
 GAXP A2 IDS 0 S   #A20+4                       GRP 22 NRQ       223 SPT 2250           BEZ 'G_NGSX_FT22_BU0400_0+G_NGSY_FT22_BU0400_0' !Measuring point Tiltmeter
 GAXP A2 IDS 0 S   #A20+7.50                    GRP 22 NRQ       223 SPT 2260           !IEXB Sensor
 GAXP A2 IDS 0 S   24.3                         GRP 22 NRQ       223 SPT 2280           !Measuring point load test
 GAXP A2 IDS 0 S   #A30-3.90                    GRP 22 NRQ       223 SPT 2281           !IEXB Sensor
 GAXP A2 IDS 0 S   #A30-0.79                    GRP 22 NRQ       224 SPT 2290           !Change in reinforcement
 GAXP A2 IDS 0 S   #A30-0.30                    GRP 22 NRQ       224 SPT 2291           !IEXB Sensor
 GAXP A2 IDS 0 S   #A30                 TYP 'S' GRP 22               SPT 2300 IDP A30   !Axis 30

!*!Label PE x.3 - GRP 13,43,23
 GAXP A3 IDS 0 S   #A10                 TYP 'S' GRP 13 NRQ       131 SPT 3100 IDP A10   !Axis 10
 GAXP A3 IDS 0 S   #A10+0.225                   GRP 13 NRQ       131 SPT 3110
 GAXP A3 IDS 0 S   #A10+2.0                     GRP 13 NRQ       132 SPT 3120           !Change in reinforcement
 GAXP A3 IDS 0 S   #A20-4                       GRP 13 NRQ       132 SPT 3140           BEZ 'G_NGSX_FT13_BU1100_0+G_NGSY_FT13_BU1100_0' !Measuring point Tiltmeter
 GAXP A3 IDS 0 S   #A20-2.6                     GRP 13 NRQ       134 SPT 3170           !Change in reinforcement
 GAXP A3 IDS 0 S   #A20-0.1             TYP 'J' GRP 43 NRQ         3 SPT 3190           !Axis 20  Joint
 GAXP A3 IDS 0 S   #A20                 TYP 'S' GRP 43 NRQ         3 SPT 3200 IDP A20   !Axis 20
 GAXP A3 IDS 0 S   #A20+0.1             TYP 'J' GRP 23 NRQ       232 SPT 3210           !Axis 20  Joint
 GAXP A3 IDS 0 S   #A20+0.3                     GRP 23 NRQ       232 SPT 3220           !IEXB Sensor
 GAXP A3 IDS 0 S   #A20+2.6                     GRP 23 NRQ       233 SPT 3230           !Change in reinforcement
 GAXP A3 IDS 0 S   #A20+3.90                    GRP 23 NRQ       233 SPT 3240           !IEXB Sensor
 GAXP A3 IDS 0 S   #A20+4                       GRP 23 NRQ       233 SPT 3250           BEZ 'G_NGSX_FT23_BU0400_0+G_NGSY_FT23_BU0400_0' !Measuring point Tiltmeter
 GAXP A3 IDS 0 S   #A20+7.50                    GRP 23 NRQ       233 SPT 3260           !IEXB Sensor
 GAXP A3 IDS 0 S   24.3                         GRP 23 NRQ       233 SPT 3280           !Measuring point load test
 GAXP A3 IDS 0 S   #A30-3.90                    GRP 23 NRQ       233 SPT 3281           !IEXB Sensor
 GAXP A3 IDS 0 S   #A30-0.79                    GRP 23 NRQ       234 SPT 3290           !Change in reinforcement
 GAXP A3 IDS 0 S   #A30-0.30                    GRP 23 NRQ       234 SPT 3291           !IEXB Sensor
 GAXP A3 IDS 0 S   #A30                 TYP 'S' GRP 23           234 SPT 3300 IDP A30   !Axis 30


!*!Label Plate elements - GRP 45
!Auxiliary points
SPT 1101 X #A10   Y -3*#B_FT/2
SPT 2101 X #A10   Y -#B_FT/2
SPT 2102 X #A10   Y #B_FT/2
SPT 3101 X #A10   Y 3*#B_FT/2

SPT 1301 X #A30   Y -3*#B_FT/2
SPT 2301 X #A30   Y -#B_FT/2
SPT 2302 X #A30   Y #B_FT/2
SPT 3301 X #A30   Y 3*#B_FT/2

!Auxiliary lines
SLN 1001 NPA 1101 1301
SLN 1002 NPA 1100 1300
SLN 1003 NPA 2101 2301
SLN 1004 NPA 2100 2300
SLN 1005 NPA 2102 2302
SLN 1006 NPA 3100 3300
SLN 1007 NPA 3101 3301

!Couplings axis 10 abutment wall-superstructure
SLN 1010 NPA 1101 1100 XFLG PLA
SLNS 97 FIX F REFT >SLN 1100
SLN 1011 NPA 1100 2101 XFLG PLA
SLNS 97 FIX F REFT >SLN 1100
SLN 1012 NPA 2101 2100 XFLG PLA
SLNS 97 FIX F REFT >SLN 2100
SLN 1013 NPA 2100 2102 XFLG PLA
SLNS 97 FIX F REFT >SLN 2100
SLN 1014 NPA 2102 3100 XFLG PLA
SLNS 97 FIX F REFT >SLN 3100
SLN 1015 NPA 3100 3101 XFLG PLA
SLNS 97 FIX F REFT >SLN 3100

SLN 1020 NPA 1301 1300
SLN 1021 NPA 1300 2301
SLN 1022 NPA 2301 2300
SLN 1023 NPA 2300 2302
SLN 1024 NPA 2302 3300
SLN 1025 NPA 3300 3301

!Definition of plate
let#t   0.17[m]   !Thickness of T-beam slab
let#Aus 'MITT'

SAR 1 GRP 45 MNR 5 NRA 7 QREF #Aus  KR POSX H1 0.15
SARB AUS          NL                               1001 T #t
     NL         1002
     NL         1010
     NL         1020

SAR 2 GRP 45 MNR 5 NRA 7 QREF #Aus  KR POSX H1 0.15
SARB AUS          NL                               1002 T #t
     NL         1003
     NL         1011
     NL         1021

SAR 3 GRP 45 MNR 5 NRA 7 QREF #Aus  KR POSX H1 0.15
SARB AUS          NL                               1003 T #t
     NL         1004
     NL         1012
     NL         1022

SAR 4 GRP 45 MNR 5 NRA 7 QREF #Aus  KR POSX H1 0.15
SARB AUS          NL                               1004 T #t
     NL         1005
     NL         1013
     NL         1023

SAR 5 GRP 45 MNR 5 NRA 7 QREF #Aus  KR POSX H1 0.15
SARB AUS          NL                               1005 T #t
     NL         1006
     NL         1014
     NL         1024

SAR 6 GRP 45 MNR 5 NRA 7 QREF #Aus  KR POSX H1 0.15
SARB AUS          NL                               1006 T #t
     NL         1007
     NL         1015
     NL         1025

!*!Label Support pre-stressing bed - GRP 90,91 - CS

#define supportSp
    let#dhspring 0.01[m]
    loop 3
             SPT  #node+3000   REF PT #node   Z #H-#HOB+#dhspring
             SPTP F REF #node GRP #GRP      !coupling
             SPTS #node+3001     DZ 1 CP     #dz   CM 1  GRP #GRP
             SPTS #node+3002     DX 1 CP     #dq   CM 1  GRP #GRP
             SPTS #node+3003     DY 1 CP     #dq   CM 1  GRP #GRP
     let#node  #node+1000
     endloop
#enddef

    let#dhspring 0.01[m]

GRUP 90  !support for all PEs (except PE 1.1)
let#GRP                   90

let#node                1190
let#dq                   1e7
let#dz                   1e7
#include supportSp

let#node                1100
let#dq                     1
let#dz                   1e7
#include supportSp

let#node               1210
let#dq                  1e7
let#dz                  1e7
#include supportSp

let#node                 1300
let#dq                      1
let#dz                    1e7
#include supportSp


GRUP 91  !support for PE 1.1
let#GRP                   91
let#node                1140
let#dq                   1e7
let#dz                   1e7
SPT  #node+3000   REF PT #node   Z #H-#HOB+#dhspring
             SPTP F REF #node GRP #GRP     !coupling
             SPTS #node+3001  DZ 1 CP  #dz CM 1  GRP #GRP
             SPTS #node+3002  DX 1 CP  1   CM 1  GRP #GRP
             SPTS #node+3003  DY 1 CP  1   CM 1  GRP #GRP

!*!Label Temporary support before CIPC - GRP 95 - CS

#define supportLG
    let#dhspring 0.03[m]
    loop 3
             SPT  #node+3005   REF PT #node   Z #H-#HOB+#dhspring XFLG A
             SPTP F REF #node GRP #GRP     !coupling
             SPTS #node+3006     DZ 1 CP  #dz  CQ #dq GRP #GRP
             SPTS #node+3007     DX 1 CP  #dq   CM 1  GRP #GRP
             SPTS #node+3008     DY 1 CP  #dq   CM 1  GRP #GRP
     let#node  #node+1000
     endloop
#enddef

LET#GRP                   95

LET#node                1100
LET#dq                     1
LET#dz                   1e7
#include supportLG

LET#node               1170
LET#dq                  1e7
LET#dz                  1e7
#include supportLG

let#node               1230
let#dq                  1e7
let#dz                  1e7
#include supportLG

!*! Simplified support axis 30 - GRP 96

#define elastomeric bearing
let#dhspring               0.05[m]
    loop 3
             SPT  #node+3005   REF PT #node   Z #H-#HOB+#dhspring
             SPTP F REF #node GRP #GRP
                SPTS #node+3006     DZ 1 CP  #dz  GRP #GRP
                SPTS #node+3007     DX 1 CP  #dq  GRP #GRP
                SPTS #node+3008     DY 1 CP  #dq  GRP #GRP

     let#node  #node+1000
endloop
#enddef


GRUP 96 !Support Axis 30 (elastomeric bearing)
let#GRP                      96

let#node                   1300
let#dq                     #kh30
let#dz                     #kz30
#include elastomeric bearing


!*! Abutment wall axis 10 - GRP 97

GRUP 97
let#GRP      97

let#HW        2.7[m]    !Height abutment wall
let#t         0.45[m]   !tickness abutment wall


SPT 1105 REF PT 1101 Z #HW   !Structural points below abutment wall
SPT 3105 REF PT 3101 Z #HW

SLN 1030 NPA 1101 1105
SLN 1031 NPA 3101 3105

!bearing stifness
LET#cpx     1E10
LET#cpy     1E10
LET#cpz     1E10
LEt#cd      1E10

SLN 1032 NPA 1105 3105
SLNS DRX 1 CA #kh10 CD 0 GRP 97
SLNS DRY 1 CA #cpy  CD #kr10 GRP 97
SLNS DRZ 1 CA #kz10 CD 0 GRP 97

SAR 8 T #t GRP 97 MNR 9 NRA 7 QREF #Aus  KR POSX
SARB AUS        NL 1010,1011,1012,1013,1014,1015
     NL       1030
     NL       1031
     NL       1032


!*! Piers Axis 20 - GRP 98
GRUP 98
let#GRP              98
let#UKpier           2.2[m] !Height of piers from the top of the foundation to the bottom of the web of the PEs

!bearing stiffness
LET#cpz 1E10
LET#cpy 1E10
LET#cpx 1E10
LET#cm 1E10

!Pier 1
SPT 1201 REF PT 1200 Z #H-#HOB
SPTP F REF 1200 GRP #GRP
SPT 1202 REF PT 1201 Z #UKpier
    SPTS  TYP CXX,CYY,CZZ CP #kh20,#cpy,#kz20 CM #kr20 GRP 98
SLN 1041 NPA 1201 1202 QNR 4 GRP #GRP

!Pier 2
SPT 2201 REF PT 2200 Z #H-#HOB
SPTP F REF 2200 GRP #GRP
SPT 2202 REF PT 2201 Z #UKpier
    SPTS TYP CXX,CYY,CZZ CP #kh20,#cpy,#kz20 CM #kr20 GRP 98
SLN 1042 NPA 2201 2202 QNR 4 GRP #GRP

!Pier 3
SPT 3201 REF PT 3200 Z #H-#HOB
SPTP F REF 3200 GRP #GRP
SPT 3202 REF PT 3201 Z #UKpier
    SPTS TYP CXX,CYY,CZZ CP #kh20,#cpy,#kz20 CM #kr20  GRP 98
SLN 1043 NPA 3201 3202 QNR 4 GRP #GRP

ENDE

!+!Chapter 02 Pre-stressing
+PROG TENDON urs:4
KOPF Clean Database
VDEL AXES 0 SGEO 0 TEND 0
ENDE

+PROG TENDON urs:9
KOPF Prestressing with Subsequent Bond
ECHO VOLL JA
STEU WARN 90420
ECHO SGEO VOLL
ECHO AXES voll


!Prestressing technology (admission nr. Z-13.71-130839)
SYSP NRSV 21 MAT 21 ZV 1116 AZ 4*150 LITZ 4 MINR 4.1 BETA 0.3 MUE 0.2 EXZ 7[mm] SS 6[mm] SF 0 LANK 0.37 LFIX 0.37 DA 52 BEZ 'subsequent bond '



!*!Label Tendon PE 1.1 subsequent bond
AXES NRH 11 TYP REFX A1 ART STAB
HOCH NRH 11 TYP KNOT S 1100,1140 SF 1,2

SGEO NRG 11 NRH 11 NRSV 21
ZPUV    S      U     V       DVS  Art  TYP=REFX
        0.00   0   0.140     -    SPAN
        0.69   0   0.170
        1.59   0   0.209
        2.49   0   0.248
        3.39   0   0.285
        4.29   0   0.317
        5.19   0   0.342
        6.09   0   0.361
        6.99   0   0.371
        7.89   0   0.372
        8.79   0   0.362
        9.69   0   0.341
        10.59   0   0.314
        11.00   0   0.300  -0.038  KOPP


AXES NRH 12 TYP REFX A1 ART STAB
HOCH NRH 12 TYP KNOT S 1140,1190 SF 1,2

SGEO NRG 12 NRH 12 NRSV 21
