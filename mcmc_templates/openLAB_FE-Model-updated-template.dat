#define VsV
AXES NRH #Achse TYP REFX #A ART STAB
HOCH NRH #Achse TYP KNOT S #p1,#p2 SF 1,2

!Tendon geometry
SGEO NRG #Achse NRH #Achse NRSV #NRSV
    !Definition of the tendon course:
    ZPUV    S     U     V   TYP=FELD      !#h is the height of the tendon position
           #s1   #e    #h
           #s2   #e    #h
           #s3   #e    #h

    !Construction phases
    CS IBA1 #BA IBA2 #BA  !Prestressing with immediate bond   (IBA1 = IBA2)

    !Assignment of tendons
    VDAT EINL #EinL ETYP LINE         !Linear force transmission on both sides
    VSIG RE ANWS 'T' KAPA 0 K3 #k3   !reduced pre-stressing to 1300 N/mm²
    TEND NRS #Achse NRG #Achse NSP 1 TYP FELD LF #LF VON 1 BIS 2 SVON #SVON SBIS #SBIS
#enddef


