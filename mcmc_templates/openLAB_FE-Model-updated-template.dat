!Definition slepper
#define schwelle

   Let#x_1    #x-#breite/2-0.08                   !0.08 due to additional load propagation at an angle of 45° up to the center of the roadway slab
   Let#y_1    -#laenge/2-0.08

   Let#x_2    #x+#breite/2+0.08
   Let#y_2    -#laenge/2-0.08

   Let#x_3    #x+#breite/2+0.08
   Let#y_3    #laenge/2+0.08

   Let#x_4    #x-#breite/2-0.08
   Let#y_4    #laenge/2+0.08

   AREA REF QGRP NR 45 TYP PG P1 #GSchwelle #x_1 #y_1     P2 #GSchwelle #x_2 #y_2     P3 #GSchwelle #x_3 #y_3     P4 #GSchwelle #x_4  #y_4   !area sleeper

#enddef

+PROG SOFILOAD URS:8
KOPF LC 2 Additional Load Sleeper

LF 2 TYP G_2  BEZ 'Additional load sleeper'

Let#laenge     2.6                              !Length
Let#width      0.3                              !Width
let#tSleeper    0.105                           !Weight timer sleeper in tonnes
let#cSleeper    0.28                            !Weight conrete sleeper in tonnes

let#xdavor    0.125
let#xdanach    1.14
let#x         0.125+0.08             !x-coordinate of first sleeper
let#breite     0.25
Let#GSchwelle  #tSleeper*9.81/((#laenge+2*0.08)*(#breite+2*0.08))   !Dead load timber sleeper kN/m
#include schwelle                    !First Sleeper

let#xdavor #xdanach
let#xdanach    1.08
let#breite     0.25
let#x    0.125+#xdavor
#include schwelle                    !Second sleeper

let#xdavor #xdanach
let#xdanach    1.06
let#breite      0.3
Let#GSchwelle  #cSleeper*9.81/((#laenge+2*0.08)*(#breite+2*0.08))   !Dead load concrete sleeper kN/m
let#x   #x+#xdavor
#include schwelle                    !Third sleeper

let#xdavor #xdanach
let#xdanach    1.15
let#x   #x+#xdavor
#include schwelle

