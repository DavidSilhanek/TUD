!SOFiSTiK Modell openLAB
!Final State

!+!Chapter 00 Update-Parameter
+PROG TEMPLATE urs:3
KOPF Steuerungsparameter

!E_FT1 - Youngs Modulus PE 1.x
!E_FT2 - Youngs Modulus PE 2.x
!E_CIPC - Youngs Modulus CIPC plate
!E_a10 - Youngs Modulus abutment wall
!E_a20 - Youngs Modulus piers axis 20
!E_CIPC_a20 - Youngs Modulus CIPC node axis 20
!kz10 - vertical spring stiffness at axis 10 (abutment wall base)
!kh10 - horizontal (longitudinal) spring stiffness at axis 10
!kr10 - rotational spring stiffness at axis 10
!kz20 - vertical spring stiffness at axis 20 (pier base)
!kh20 - horizontal spring stiffness at axis 20
!kr20 - rotational spring stiffness at axis 20
!kz30 - vertical spring stiffness at axis 30 (elastomeric bearing)
!kh30 - horizontal (longitudinal) spring stiffness at axis 30


$----

!f_lpt - transmission length of the prestressing tendons (in the case of immediate bond)

!m_fz - total mass of the heavy vehicle, including the frame
!l_ach - axle spacing
!spur - track width
!b_rad - side length of the square wheel contact area
!dx_fz - longitudinal offset of the vehicle relative to its target position

$----

#include parameter.dat

ENDE


!+!Chapter 01 General Parameter
+PROG TEMPLATE urs:11
KOPF General Parameters

!Bridge
STO#L1          15[m]            !Span length 1.x
STO#L2          15[m]            !Span length 2.x
STO#A10          0[m]            !Station axis 10
STO#A20        #L1               !Station axis 20  [m]
STO#A30        #L1+#L2           !Station axis 30  [m]

STO#L0         0.15*(#L1+#L2)

!Cross-section parameters of a precast element + cast-in-place concrete addition

STO#B_Steg      0.25[m]            !Width of the web
STO#B_Krag      0.625[m]           !Width of the cantilever arms
STO#H_Kraga     0.17[m]            !Height of the cantilever outside
STO#H_Kragi     0.19[m]            !Height of the cantilever inside
STO#H           0.59[m]            !Height of the beam

!Cast-in-place concrete slab
STO#HOB          0.09[m]                                !Thickness of the cast-in-place concrete

STO#A_FT         3                                      !Number of precast elements

STO#B_FT         #B_Steg+#B_Krag*2                      !Width of the precast element
STO#B_Ueb        #A_FT*(#B_FT+0.001)-0.001              !Width of the entire superstructure

sto#ZMAX 2.6
sto#ZMIN -1
ENDE


!+!Chapter 01 FE-Model generation

!Definition of PE cross-sections
#define QNR
   QNR #QNR  MNR #MNR MBW  3   BEZ #BEZ
                BA    1  !Construction phase 1 precast plant(PP): precast cross-section is activated
                QPOL  UPZ MNR #MNR

                QP TOP1         0           0             EXP 1 !Ventilation completely given for creep and shrinkage in the PP
                   1            #B_FT/2     0             EXP 1 !for all following QPs
                   2            #B_FT/2     #H_Kraga-#HOB
                   3            #B_Steg/2   #H_Kragi-#HOB
                   4            #B_Steg/2   #H-#HOB

                QSP    NR     Y      Z       MNR
                       'TOP1' 0      0       #MNR
                       'BOT'  0      #H-#HOB #MNR

                RANG 6 'TORS'   TYP OPT          !Torsion-active reinforcement

                RANG 1 'BOT'    TYP MIN          !bottom reinforcement PE
                RANG 3 'TOPFT'  TYP MIN          !upper reinforcement PE
                RANG 2 'TOPOB'  TYP MIN MBW 6    !upper reinforcement cast-in-place concrete slab
                RANG 4 'BUEG'   TYP MIN MBW 4    !stirrup reinforcement


                !Longitudinal reinforcement PE:
                  LET#ytop        #B_FT/2-0.08[m]
                  LET#ybot        #B_Steg/2-0.025-#DT-(#DB112/2)
                  LET#ztop        0.03[m]
                  LET#zbot        #H-#HOB-0.055[m]

                !Top slab:
                LBEW 'FT1ObenRechts3xd10' YA -#ytop           YE -#B_Steg/2-0.15     ZA #ztop                          ZE #ztop                          D #DFTOben TORS PASS RANG 3 A 3[-]   DIST FULL
                LBEW 'FT1ObenLinks3xd10'  YA  #ytop           YE  #B_Steg/2+0.15     ZA #ztop                          ZE #ztop                          D #DFTOben TORS PASS RANG 3 A 3[-]   DIST FULL
                LBEW 'FT1ObenMitte2xd10'  YA  #B_Steg/2-0.04  YE -#B_Steg/2+0.04     ZA #ztop+#DT+#DFTOben             ZE #ztop+#DT+#DFTOben             D #DFTOben TORS AKTI RANG 3 A 2[-]   DIST FULL
                LBEW 'FT1ObenRechts2xd10' YA -#B_FT/2+0.115   YE -#B_FT/2+0.115+0.45 ZA #ztop+#DT+#DFTOben             ZE #ztop+#DT+#DFTOben             D #DFTOben TORS PASS RANG 3 A 2[-]   DIST FULL
                LBEW 'FT1ObenLinks2xd10'  YA  #B_FT/2-0.115   YE  #B_FT/2-0.115-0.45 ZA #ztop+#DT+#DFTOben             ZE #ztop+#DT+#DFTOben             D #DFTOben TORS PASS RANG 3 A 2[-]   DIST FULL
                !Web:
                LBEW 'FT1MitteStegME2xd10'YA  #B_Steg/2-0.02  YE -#B_Steg/2+0.02     ZA #ztop+0.105                    ZE #ztop+0.105                    D #DFTOben TORS PASS RANG 3 A 2[-]   DIST FULL
                LBEW 'FT1MitteSteg2xd10'  YA -#ybot           YE  #ybot              ZA #zbot-0.15                     ZE #zbot-0.15                     D #DFTOben TORS PASS RANG 3 A 2[-]   DIST FULL
                LBEW 'FT1UntenSteg2x10'   YA -#ybot           YE  #ybot              ZA #zbot                          ZE #zbot                          D #DB      TORS AKTI RANG 1 A #AB[-] DIST FULL

                !Shear cuts
                QS 'SO' TYP STEG ZA #H_Kragi-#HOB+0.01   ZE  #H_Kragi-#HOB+0.01  YA +#B_FT/2   YE -#B_FT/2     MNR #MNR MBW 4  RANG 4  ASB #ASB[cm2/m]
                QS 'SMO' TYP STEG ZA #H_Kragi-#HOB+0.1   ZE  #H_Kragi-#HOB+0.1   YA +#B_FT/2   YE -#B_FT/2     MNR #MNR MBW 4  RANG 4  ASB #ASB[cm2/m]
                QS 'SM' TYP STEG ZA #H_Kragi-#HOB+0.2    ZE  #H_Kragi-#HOB+0.2   YA +#B_FT/2   YE -#B_FT/2     MNR #MNR MBW 4  RANG 4  ASB #ASB[cm2/m]
                QS 'SU' TYP STEG ZA #H-#HOB-0.08         ZE  #H-#HOB-0.08        YA -#B_FT/2   YE +#B_FT/2     MNR #MNR MBW 4  RANG 4  ASB #ASB[cm2/m]

                !Cast-in-place concrete deck
                BA 40  !Construction phase 40 : = total cross-section (cast-in-place concrete layer is activated in BA 40)
                QPOL  UPZ MNR 2
                QP  TOP4                  0         -#HOB   EXP 1.0 !Complete ventilation as there is no coating
                QP  11                    #B_FT/2   -#HOB   EXP 1.0
                QP  12                    #B_FT/2   0       EXP 1.0
                QP  13                    0         0       EXP 0.2 !Ventilation at the bottom, contact with PE

                QSP    NR     Y       Z    MNR
                       'TOP' 0      -#HOB   2
                       'BOT4' 0         0   2

                !Longitudinal reinforcement cast-in-place concrete deck
                let#ztop -#HOB+0.05[m]
                let#ytop  #B_FT/2-0.05[m]

                !Reinforcement in standard cross-section
                IF (#QNR==112)|(#QNR==122)|(#QNR==132)|(#QNR==213)|(#QNR==223)|(#QNR==233)
                LBEW 'F1OB_ObenRechts3x10' YA -#ytop          YE -#ytop+0.40     ZA #ztop ZE #ztop D #DO TORS PASS RANG 2 DIST FULL A 3[-] MBW 6
                LBEW 'F1OB_ObenLinks3x10'  YA  #ytop          YE  #ytop-0.40     ZA #ztop ZE #ztop D #DO TORS PASS RANG 2 DIST FULL A 3[-] MBW 6
                LBEW 'F1OB_ObenMitte2x10'  YA  #B_Steg/2-0.06 YE -#B_Steg/2+0.06 ZA #ztop ZE #ztop D #DO TORS PASS RANG 2 DIST FULL A 2[-] MBW 6
                ENDIF

                !Reinforcement abutment wall axis 10:
                IF (#QNR==111)|(#QNR==121)|(#QNR==131)
                LBEW 'F1OB_ZulageAnkerkopfd10x16' YA #B_FT/2-0.075 YE -#B_FT/2+0.075 ZA #ztop ZE #ztop D 16[mm] TORS PASS RANG 2 DIST FULL A 10[-] MBW 6
                ENDIF

                !Reinforcement axis 20:
                IF (#QNR==113)|(#QNR==114)|(#QNR==123)|(#QNR==124)|(#QNR==133)|(#QNR==134)|(#QNR==211)|(#QNR==212)|(#QNR==221)|(#QNR==222)|(#QNR==231)|(#QNR==232)
                LBEW 'F1OB_ZulageAnkerkopfd11x16' YA #B_FT/2-0.075 YE -#B_FT/2+0.075 ZA #ztop ZE #ztop D 16[mm] TORS PASS RANG 2 DIST FULL A 11[-] MBW 6
                ENDIF


                !Reinforcement axis 30
                IF (#QNR==214)|(#QNR==224)|(#QNR==234)
                LBEW 'F1OB_Oben14d10 auf alle verteilt'  YA  #B_FT/2-0.075   YE -#B_FT/2+0.075   ZA #ztop ZE #ztop D 10[mm] TORS PASS RANG 2 DIST FULL A 6[-] MBW 6
                ENDIF


                QW IT #IT   !40% adjustment of torsional moments of inertia

#enddef

#define QNRCIPC
          QNR   #QNR MNR #MNR MBW  3  BEZ #BEZ
            BA    40  $
            QPOL  UPZ MNR #MNR

            QP TOP1         0           -#HOB           EXP 1 !Ventilation completely given for creep and shrinkage in the PP
               1            #B_FT/2     -#HOB           EXP 1 !for all following QPs
               2            #B_FT/2     #H_Kraga-#HOB
               3            #B_Steg/2   #H_Kragi-#HOB
               4            #B_Steg/2   #H-#HOB

            QSP    NR     Y       Z    MNR
                   'TOP' 0      -#HOB  #MNR
                   'BOT' 0    #H-#HOB  #MNR



            RANG 6 'TORS' TYP OPT           !Torsion-active reinforcement

            RANG 1 'BOT'   TYP MIN          !Reinforcement bottom
            RANG 2 'TOPOB' TYP MIN MBW 6    !Reinforcement top
            RANG 4 'BUEG'  TYP MIN MBW 4    !Stirrups

            let#ztop -#HOB+0.05[m]
            let#ytop  #B_FT/2-0.05[m]

            LBEW 'STOben'           YA -#ytop   YE #ytop     ZA #ztop          ZE #ztop          D #DStuetz TORS PASS RANG 2 A #AStuetz[-] DIST FULL  MBW 6
            LBEW 'STOben2xd8'       YA  0.11[m] YE -0.11[m]  ZA 0.13[m]        ZE 0.13[m]        D 8[mm]    TORS PASS RANG 1 A 2[-] DIST FULL
            LBEW 'STMitteSteg2xd8'  YA  0.11[m] YE -0.11[m]  ZA 0.13+0.15[m]   ZE 0.13+0.15[m]   D 8[mm]    TORS PASS RANG 1 A 2[-] DIST FULL
            LBEW 'STUntenSteg2xd8'  YA  0.11[m] YE -0.11[m]  ZA 0.13+2*0.15[m] ZE 0.13+2*0.15[m] D 8[mm]    TORS PASS RANG 1 A 2[-] DIST FULL

            !Shear cuts
            QS 'SO'  TYP STEG ZA #H_Kragi-#HOB+0.01   ZE  #H_Kragi-#HOB+0.01  YA +#B_FT/2   YE -#B_FT/2  MNR #MNR  MBW 4  RANG 4 ASB #ASB[cm2/m]
            QS 'SMO' TYP STEG ZA #H_Kragi-#HOB+0.1    ZE  #H_Kragi-#HOB+0.1   YA +#B_FT/2   YE -#B_FT/2  MNR #MNR  MBW 4  RANG 4 ASB #ASB[cm2/m]
            QS 'SM'  TYP STEG ZA #H_Kragi-#HOB+0.2    ZE  #H_Kragi-#HOB+0.2   YA +#B_FT/2   YE -#B_FT/2  MNR #MNR  MBW 4  RANG 4 ASB #ASB[cm2/m]
            QS 'SU'  TYP STEG ZA #H-#HOB-0.08         ZE  #H-#HOB-0.08        YA -#B_FT/2   YE +#B_FT/2  MNR #MNR  MBW 4  RANG 4 ASB #ASB[cm2/m]

            QW IT #IT   !40% adjustment of torsional moments of inertia
            QW MNR #MNR FAKE #EOBVERGUSS
#enddef

!Calculation of effective width PEs
#define MBW

                LET#l0_S      0.15*(#L1+#L2)       ; PRT#l0_S         ![m] Distance moment zero points
                LET#b1        #B_Krag              ; PRT#b1           ![m] width of cantilever
                LET#beff_1   0.2*#b1+0.1*#l0_S     ; PRT#beff_i1

                If (#beff_1 > 0.2*#l0_S)
                    LET#beff_1 0.2*#l0_S
                Elseif (#beff_1 >= #b1)
                     #beff_1 #b1
                Endif                              ; PRT#beff_1       !Check

            !Covering the non-effective areas
                NEFF       YMIN=[m]                    ZMIN=[m]        YMAX=[m]            ZMAX=[m]   TYPE
                        (#B_Steg)/2+#beff_1             -#H               10                   #H         Z
                       ((#B_Steg)/2+#beff_1)*-1         -#H              -10                   #H         Z
#enddef

!Calculation of effective width cast-in-place concrete cross-sections
#define MBWCIPC

                Let#l0_S      0.15*(#L1+#L2)       ; prt#l0_S         ![m] Distance moment zero points
                Let#b1        #B_Krag              ; prt#b1           ![m] width of cantilever
                Let#beff_1   0.2*#b1+0.1*#l0_S     ; prt#beff_i1

                If (#beff_1 > 0.2*#l0_S)
                    Let#beff_1 0.2*#l0_S
                Elseif (#beff_1 >= #b1)
                     #beff_1 #b1
                Endif                              ; prt#beff_1 !Kontrolle

            !Covering the non-effective areas
                NEFF       YMIN=[m]                    ZMIN=[m]        YMAX=[m]            ZMAX=[m]     TYPE
                        (#B_Steg)/2+#beff_1             -#HOB               10                 #H         Z
                       ((#B_Steg)/2+#beff_1)*-1         -#HOB              -10                 #H         Z


#enddef

#define QNRPier
            QNR #QNR MNR 8 MBW 3 BTYP BEAM BEZ #BEZ
            LET#bS 0.25[m]
            LET#h  0.20[m]

                !Definition of geometry point
                QSP NR  Y=[m]               Z=[m]   MNR=0
                    M   0                   0
                    OR  #bS/2               #h/2
                    UR  #bS/2               -#h/2
                    UL  -#bS/2              -#h/2
                    OL  -#bS/2               #h/2

                 QSP    NR     Y      Z        MNR
                       'TOP'   0      -#h/2    8
                       'BOT'   0      #h/2     8

                !Definition of polygonal cross-section
                QPOL U
                QP  NR  Y=[m]        Z=[m]      REFP
                    51  0            0          OR
                    52  0            0          UR
                    53  0            0          UL
                    54  0            0          OL

            RANG 7 'Pier' TYP MIN

                              LET#ytop        #bS/2-0.02-0.008-#DStuetze/2
                              LET#ybot       -#bS/2+0.02+0.008+#DStuetze/2
                              LET#ztop        #h/2-0.02-0.008-#DStuetze/2
                              LET#zbot       -#h/2+0.02+0.008+#DStuetze/2

                             IF #QNR==4                  !Reinforcement Pier 1
                             LBEW  YA #ytop YE #ybot ZA #ztop ZE #ztop D 10[mm] TORS AKTI RANG 7 DIST FULL A 5[-] MBW 3
                             LBEW  YA #ytop YE #ybot ZA #zbot ZE #zbot D 10[mm] TORS AKTI RANG 7 DIST FULL A 5[-] MBW 3
                             ENDIF

                             IF (#QNR==5)|(#QNR==6)      !Reinforcement Pier 2 & 3
                             BEW Y #ytop   Z #ztop  RANG 7 TORS AKTI D #DStuetze
                             BEW Y #ybot   Z #ztop  RANG 7 TORS AKTI D #DStuetze
                             BEW Y #ybot   Z #zbot  RANG 7 TORS AKTI D #DStuetze
                             BEW Y #ytop   Z #zbot  RANG 7 TORS AKTI D #DStuetze
                             ENDIF
#enddef

+PROG AQUA URS:1
KOPF Materials and Cross-sections
ECHO VOLL VOLL
ECHO QUER EXTR
NORM DC DIN NDC EN199X-200X-Bridge CAT B      !according to Eurocode 2

!*!Label Materials
!Concrete - updated concrete compression strengths based on material tests.
$BETO NR 1 ART C FCN 31R EC #E_FT1 FCT 3.03 FCTK 2.12  BEZ "PE span 1"                       !Pre-cast elements span 1
$ARBL EPS GEBR
$ARBL EPS  0.181 SIG   0     TYP POL
$ARBL EPS  0.091 SIG   3.03  TYP POL
$ARBL EPS  0.000 SIG   0     TYP POL
$ARBL EPS -0.550 SIG -17.10  TYP SPL
$ARBL EPS -1.099 SIG -29.67  TYP SPL
$ARBL EPS -1.649 SIG -37.44  TYP SPL
$ARBL EPS -2.198 SIG -40.10  TYP SPL
$ARBL EPS -3.500 SIG -24.06  TYP SPL
$MEXT 1 TYP EIGE VAL1 1 VAL2 1 VAL3 1 VAL4 1 VAL5 1 VAL6 1
$#include material_1.dat

#include material_11.dat
#include material_111.dat
#include material_12.dat
#include material_13.dat

$BETO NR 7 ART C FCN 56R EC #E_FT2 FCT 4.29 FCTK 3.00  BEZ "PE span 2"                       !Pre-cast elements span 2
$ARBL EPS GEBR
$ARBL EPS  0.222 SIG   0     TYP POL
$ARBL EPS  0.111 SIG   4.29  TYP POL
$ARBL EPS  0.000 SIG   0     TYP POL
$ARBL EPS -0.640 SIG -24.44  TYP SPL
$ARBL EPS -1.280 SIG -44.92  TYP SPL
$ARBL EPS -1.920 SIG -59.65  TYP SPL
$ARBL EPS -2.561 SIG -65.60  TYP SPL
$ARBL EPS -3.098 SIG -59.82  TYP SPL
$MEXT 7 TYP EIGE VAL1 1 VAL2 1 VAL3 1 VAL4 1 VAL5 1 VAL6 1
$#include material_7.dat

#include material_221.dat
#include material_222.dat
#include material_223.dat


$BETO NR 2 ART C FCN 34N EC #E_CIPC FCT 3.23 FCTK 2.26  BEZ "CIPC beam elements"             !Cast-in-place concrete (CIPC) beam elements
$ARBL EPS GEBR
$ARBL EPS  0.189 SIG   0     TYP POL
$ARBL EPS  0.094 SIG   3.23  TYP POL
$ARBL EPS  0.000 SIG   0     TYP POL
$ARBL EPS -0.563 SIG -18.13  TYP SPL
$ARBL EPS -1.126 SIG -31.76  TYP SPL
$ARBL EPS -1.690 SIG -40.38  TYP SPL
$ARBL EPS -2.253 SIG -43.40  TYP SPL
$ARBL EPS -3.500 SIG -26.53  TYP SPL
$MEXT 2 TYP EIGE VAL1 1 VAL2 1 VAL3 1 VAL4 1 VAL5 1 VAL6 1
#include material_2.dat


$BETO NR 9 ART C FCN 48R EC #E_a10 FCT 4.04 FCTK 2.83 BEZ "CIPC abutment wall axis 10"      !Cast-in-place concrete abutment wall
$MEXT 9 TYP EIGE VAL1 1 VAL2 1 VAL3 1 VAL4 1 VAL5 1 VAL6 1
#include material_9.dat

$BETO NR 8 ART C FCN 46R EC #E_a20 FCT 3.83 FCTK 2.68  BEZ "CIPC piers axis 20"             !Cast-in-place concrete piers and connection superstructure axis 20
$ARBL EPS GEBR
$ARBL EPS  0.210 SIG   0     TYP POL
$ARBL EPS  0.105 SIG   3.83  TYP POL
$ARBL EPS  0.000 SIG   0     TYP POL
$ARBL EPS -0.601 SIG -21.14  TYP SPL
$ARBL EPS -1.203 SIG -37.97  TYP SPL
$ARBL EPS -1.804 SIG -49.34  TYP SPL
$ARBL EPS -2.405 SIG -53.60  TYP SPL
$ARBL EPS -3.500 SIG -34.62  TYP SPL
$MEXT 8 TYP EIGE VAL1 1 VAL2 1 VAL3 1 VAL4 1 VAL5 1 VAL6 1
#include material_8.dat

$BETO NR 10 ART C FCN 46R EC #E_CIPC_a20  FCT 3.83 FCTK 2.68 BEZ "CIPC node axis 20"
$ARBL EPS GEBR
$ARBL EPS  0.210 SIG   0     TYP POL
$ARBL EPS  0.105 SIG   3.83  TYP POL
$ARBL EPS  0.000 SIG   0     TYP POL
$ARBL EPS -0.601 SIG -21.14  TYP SPL
$ARBL EPS -1.203 SIG -37.97  TYP SPL
$ARBL EPS -1.804 SIG -49.34  TYP SPL
$ARBL EPS -2.405 SIG -53.60  TYP SPL
$ARBL EPS -3.500 SIG -34.62  TYP SPL
$MEXT 10 TYP EIGE VAL1 1 VAL2 1 VAL3 1 VAL4 1 VAL5 1 VAL6 1
#include material_10.dat


$BETO NR 5 ART C FCN 34N EC #E_CIPC GAM 0 FCT 3.23 FCTK 2.26 BEZ "Plate elements"           !Plate element
$MEXT 5 TYP EIGE VAL1 0 VAL2 0 VAL3 0 VAL4 0 VAL5 0 VAL6 0
#include material_5.dat

!Reinforcement Steel
STAH NR 3 ART B GUET 500B BEZ "Reinforcement PEs"          !Longitudinal reinforcement PEs
STAH NR 4 ART B GUET 500B BEZ "Stirrups"                   !Stirrups
STAH NR 6 ART B GUET 500B BEZ "Reinforcement CIPC"         !Longitudinal reinforcement Cast-in-place concrete

!Prestressing steel
STAH NR 20 ART Y GUET 1860 FT 1860 ES 193000 FY 1660 REL1 2.0 REL2 1.0 BEZ "Pre-stressing steel immediate bond"   !Prestressing steel St1660/1860 immediate bond
STAH NR 21 ART Y GUET 1860 FT 1860 ES 195000 FY 1600 REL1 2.0 REL2 1.0 BEZ "Pre-stressing steel subsequent bond"         !Prestressing steel S1660/1860 subsequent bond

LET#IT -0.4
LET#EOBVERGUSS 1

!Torsion:
LET#DT 10[mm]

!Upper reinforcement PE (all equal)
LET#DFToben 10[mm]
LET#AFToben 8[mm]

!PE 1.1
!Reinforcement cast-in-place concrete deck
let#DO111 10[mm];   let#DO112 10[mm];      let#DO113 10[mm];     let#DO114 10[mm]

!Longitudinal Reinforcement PE
let#DB111 10[mm];   let#DB112 10[mm];      let#DB113 10[mm];     let#DB114 10[mm]
let#AB111 2 ;   let#AB112 2 ;      let#AB113 2 ;     let#AB114  2

!PE 1.2
!Reinforcement cast-in-place concrete deck
let#DO121 10[mm];   let#DO122 10[mm];      let#DO123 10[mm];     let#DO124 10[mm]

!Longitudinal Reinforcement PE
let#DB121 10[mm];   let#DB122 10[mm];      let#DB123 10[mm];     let#DB124 10[mm]
let#AB121 2 ;   let#AB122 2 ;      let#AB123 2 ;     let#AB124  2

!PE 1.3
!Reinforcement cast-in-place concrete deck
let#DO131 10[mm];   let#DO132 10[mm];      let#DO133 10[mm];     let#DO134 10[mm]

!Longitudinal Reinforcement PE
let#DB131 16[mm];   let#DB132 16[mm];      let#DB133 16[mm];     let#DB134 16[mm]
let#AB131 3 ;   let#AB132 3 ;      let#AB133 3 ;     let#AB134  3

!PE 2.1
!Reinforcement cast-in-place concrete deck
let#DO211 10[mm];   let#DO212 10[mm];      let#DO213 10[mm];     let#DO214 10[mm]

!Longitudinal Reinforcement PE
let#DB211 10[mm];   let#DB212 10[mm];      let#DB213 10[mm];     let#DB214 10[mm]
let#AB211 2 ;   let#AB212 2 ;      let#AB213 2 ;     let#AB214  2

!PE 2.2
!Reinforcement cast-in-place concrete deck
let#DO221 10[mm];   let#DO222 10[mm];      let#DO223 10[mm];     let#DO224 10[mm]

!Longitudinal Reinforcement PE
let#DB221 10[mm];   let#DB222 10[mm];      let#DB223 10[mm];     let#DB224 10[mm]
let#AB221 2 ;   let#AB222 2 ;      let#AB223 2 ;     let#AB224  2

!PE 2.3
!Reinforcement cast-in-place concrete deck
let#DO231 10[mm];   let#DO232 10[mm];      let#DO233 10[mm];     let#DO234 10[mm]

