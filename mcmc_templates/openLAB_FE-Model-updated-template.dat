+PROG SOFILOAD urs:56
KOPF LC 100 Load Test

LET#b   0.2[m]
LET#l   0.2[m]
LET#P   50/(0.2*0.2)  !Load used for load capacity iteration


LET#LF  100
LET#x   24.3[m]     !Position of load in x-direction

    !Definition of the contact surface of the hydraulic cylinder
       Let#x_1   #x-#l/2
       Let#y_1   -#B_FT-#b/2

       Let#x_2   #x_1
       Let#y_2   #y_1+#b

       Let#x_3   #x_1+#l
       Let#y_3   #y_1+#b

       Let#x_4   #x_1+#l
       Let#y_4   #y_1

    LF  #LF BEZ "Load test #(#x,6.2) m" TYP NONE
        AREA REF QGRP NR 45 TYP PG P1 #P #x_1 #y_1 P2 #P #x_2 #y_2 P3 #P #x_3 #y_3 P4 #P #x_4 #y_4

ENDE


#define Belastungsfahrzeug

AREA QGRP NR 45 PROJ zz TYP pzz p1 #p x1 #xm-#l/2-#b/2  -#spur/2-#b/2       x2 #xm-#l/2-#b/2  -#spur/2+#b/2     x3 #xm-#l/2+#b/2  -#spur/2+#b/2     x4 #xm-#l/2+#b/2  -#spur/2-#b/2

AREA QGRP NR 45 PROJ zz TYP pzz p1 #p x1 #xm+#l/2-#b/2  -#spur/2-#b/2       x2 #xm+#l/2-#b/2  -#spur/2+#b/2     x3 #xm+#l/2+#b/2  -#spur/2+#b/2     x4 #xm+#l/2+#b/2  -#spur/2-#b/2

AREA QGRP NR 45 PROJ zz TYP pzz p1 #p x1 #xm+#l/2-#b/2  #spur/2-#b/2         x2 #xm+#l/2-#b/2  #spur/2+#b/2     x3 #xm+#l/2+#b/2  #spur/2+#b/2      x4 #xm+#l/2+#b/2  #spur/2-#b/2

AREA QGRP NR 45 PROJ zz TYP pzz p1 #p x1 #xm-#l/2-#b/2  #spur/2-#b/2         x2 #xm-#l/2-#b/2  #spur/2+#b/2     x3 #xm-#l/2+#b/2  #spur/2+#b/2      x4 #xm-#l/2+#b/2  #spur/2-#b/2

#enddef

+PROG SOFILOAD urs:10
KOPF LC 200+ Load test reference phase

LET#l          #l_ach
LET#spur       #spur
LET#b          #b_rad
LET#p #m_fz*9.81/4/(#b*#b)

!*!Label LS 2
LF 202 TYP None BEZ "Belastungsfahrt LS 2"
LET#xm          26.25[m]
#include Belastungsfahrzeug

!*!Label LS 3
LF 203 TYP None BEZ "Belastungsfahrt LS 3"
LET#xm          22.5[m]
#include Belastungsfahrzeug

!*!Label LS 4
LF 204 TYP None BEZ "Belastungsfahrt LS 4"
LET#xm          18.75[m]
#include Belastungsfahrzeug

!*!Label LS 5
LF 205 TYP None BEZ "Belastungsfahrt LS 5"
LET#xm          7.5[m]
#include Belastungsfahrzeug

ENDE

! the Vehicle crossing in the reference stage
+PROG SOFILOAD urs:19
KOPF LC 300+ Vehicle - lighter - crossing - Influence lines
STEU WARN 909

LET#l          #l_ach
LET#spur       #spur
LET#b          #b_rad
LET#p (#m_fz-0.8)*9.81/(4*(#b*#b))

LET#step 0.5 ! vehicle step in meters

LOOP#i 60
    LET#xm  0+#l/2+#b/2+0.5*#i
    LET#LF  301+#i
    LF #lf TYP NONE BEZ "Influence line xm = #(#xm,6.2) m"
    #include Belastungsfahrzeug
ENDLOOP

ENDE


+PROG SOFILOAD urs:20
KOPF LC 400+ Temperature loads

LET#dT_N    1
LET#dT_M    1

LF 401 TYP None BEZ "dT_N Überbau"
    STAB GRP (10 13 1) TYP DT PA #dT_N
    STAB GRP (21 23 1) TYP DT PA #dT_N
    STAB GRP (41 43 1) TYP DT PA #dT_N

LF 402 TYP None BEZ "dT_M Überbau"
    STAB GRP (10 13 1) TYP DTZ PA #dT_M
    STAB GRP (21 23 1) TYP DTZ PA #dT_M
    STAB GRP (41 43 1) TYP DTZ PA #dT_M

ENDE


+PROG ASE urs:15
KOPF Linear-elastic w/o CSM
STEU WARN 147

GRUP  - BA 998
GRUP 90 NEIN
GRUP 91 NEIN
GRUP 95 NEIN

GRP2 45 QEMX 0.001 QUEA 0.001      !Deactivate stiffness of plate elements in x-direction
  STEU SOLV
  STEU WARN 185,197,335,398,399
  LF 1
  LF 2
  LF 3
  LF 100
  LF (202 204 1)
  LF (301 360 1)
  LF 401
  LF 402

ENDE

!+!Chapter 04 Construction Process
+PROG CSM urs:12
KOPF Construction Process
STEU OPT  EG        WERT                                     AUTO
STEU OPT  KRIE      WERT                                     RKRI
STEU OPT  RELZ      WERT                                     AUTO
STEU OPT  krag      WERT                                     12
$STEU OPT  krag      WERT 2
STEU ASE  text      'if xxx_ba_csm<20 ; steu krag 0 ; endif'
STEU OPT  SPEI      WERT                                      1
STEU OPT  GPCS      WERT                                      0
STEU OPT  EMOD      WERT                                      0
STEU OPT  GUSS      WERT                                      1
UEBE 50

$UEBE 50
$GRP0 11
$GRP0 12
$GRP0 13
$GRP0 21
$GRP0 22
$GRP0 23

STEU WARN   197
STEU WARN   116
STEU WARN   132
STEU WARN 12149
STEU WARN 70121

!Constrction phases
BA 10 TYP  G_1 BEZ 'Dead load prefabrication plant'

BA 11 TYP  P_0 BEZ 'Prestressing with immediate bond, except PE 1.1'
BA 12 TYP  P_1 BEZ 'Prestressing with subsequent bond PE 2.1.'
BA 13 TYP  P_1 BEZ 'Partial prestressing with subsequent bond PE 1.1 part 1'   FAKP  0.5145                                                                                                   ! 0.337/0.655 Spannfaktoren nach Schlupf
!BA 14 grouting PE 2.1
BA 15 TYP  G_1 BEZ 'Dead load PE 1.1. part 1'
BA 16 TYP  P_1 BEZ 'Partial prestressing with subsequent bond PE 1.1 part 2' FAKP  0.4726                                                                                                   ! 0,276/0,584 Spannfaktoren nach Schlupf
BA 17 TYP  P_0 BEZ 'Prestressing with immediate bond PE 1.1''

BA 20 TYP  P_1 BEZ 'Full prestressing with subsequent bond PE 1.1 part 1' IBA1 13  FAKP  1
BA 21 TYP  P_1 BEZ 'Full prestressing with subsequent bond PE 1.1 part 2' IBA1 16  FAKP  1
!BA 22 grouting PE 1.1.
BA 25 TYP  C_1 BEZ 'Creep in prefabrication plant'  T 90 RH 70 TEMP 10 NKRI 5

BA 41 TYP  B   BEZ 'Relocating elastomeric bearings'


$BA 42 TYP C_1 BEZ 'Creep after assembling PEs' T 66 RH 70 TEMP 10 NKRI 3

!steps for joining the rest of the structure
! step 43 - krag 0 placeholder
BA 42 krag 0   TYP G_1 BEZ  'x h.s. - Adding the supports - columns, wall'
! step 43 - krag 1 placeholder
BA 43 krag 1   TYP G_1 BEZ  '2023-11-27 ... Assembly of all PEx h.s. - Adding the supports - cips above walls'
$BA 44 TYP G_1   BEZ ' - Adding the supports'

!creep in period 2023-11-27 -- 2024-02-01  ... 66 days
BA 44 TYP  C_1 BEZ '2023-11-27 -- 2024-02-01 ... Creep after assembling PEs'   T  66   RH   70 TEMP 10 NKRI 3

! dead load from the in-sutu concrete
BA 45 TYP  G_1 BEZ '2024-02-01  ... G_1 Concreting cast-in-place concrete slab'
! creep after adding the in situ concrete -21 days
BA 47 TYP  C_1 BEZ '2024-02-01 -- 2024-02-22 ... Creep after adding the concrete layer' T 21  RH   70 TEMP 10 NKRI 1
BA 50 TYP  B   BEZ '2024-02-22 Hardening CIPC'


$BA 49 krag 1 TYP G_1   BEZ 'Adding the supports'
$BA 50 TYP B   BEZ 'Hardening CIPC'


$BA 60 TYP G_1 BEZ 'Relocation final support'
$BA 65 TYP C_1 BEZ 'Creep after construction' T 90 RH 70 TEMP 10 NKRI 5
BA 64 TYP  G   BEZ '2024-02-22 Scaffolding removal'
! creep before the additional load (vehicle, rails etc...) - 25 days
BA 65 TYP  C_1 BEZ 'Creep after construction'                                                             T    25                                                                                 RH   70 TEMP 10 NKRI 5


BA 70 TYP  G_2 BEZ '2024-03-18 ... Instalation of tracks for the loaad vehicle ... Additional dead load'; LF   2,3
! creep before the the load test - 2025-05-06 - 414 days
BA 75 TYP C_2 BEZ '2024-03-18 -- 2025-05-06 ... Creep until start of load test' T 414 RH 70 TEMP 10 NKRI 10

!Group table
$PRECASTED ELEMENTS
$GRUP 10 IBA1 15  WBIS  -    GFIX 99999 BETT 10 ORTG 45 T0 3 FAK1 1 IBAG    15 PHIF 0
$GRUP 11 IBA1 10  WBIS  -    GFIX 99999 BETT 10 ORTG 45 T0 3 FAK1 1 IBAG    10 PHIF 0
$GRUP 12 IBA1 10  WBIS  -    GFIX 99999 BETT 10 ORTG 45 T0 3 FAK1 1 IBAG    10 PHIF 0
$GRUP 13 IBA1 10  WBIS  -    GFIX 99999 BETT 10 ORTG 45 T0 3 FAK1 1 IBAG    10 PHIF 0
$GRUP 21 IBA1 10  WBIS  -    GFIX 99999 BETT 10 ORTG 45 T0 3 FAK1 1 IBAG    10 PHIF 0
$GRUP 22 IBA1 10  WBIS  -    GFIX 99999 BETT 10 ORTG 45 T0 3 FAK1 1 IBAG    10 PHIF 0
GRUP 10 IBA1 15  WBIS   -   GFIX 99999 BETT 10 ORTG  45 T0 3 FAK1 1 IBAG      15 PHIF 0
GRUP 11 IBA1 10  WBIS   -   GFIX 99999 BETT 10 ORTG  45 T0 3 FAK1 1 IBAG      10 PHIF 0
GRUP 12 IBA1 10  WBIS   -   GFIX 99999 BETT 10 ORTG  45 T0 3 FAK1 1 IBAG      10 PHIF 0
GRUP 13 IBA1 10  WBIS   -   GFIX 99999 BETT 10 ORTG  45 T0 3 FAK1 1 IBAG      10 PHIF 0
GRUP 21 IBA1 10  WBIS   -   GFIX 99999 BETT 10 ORTG  45 T0 3 FAK1 1 IBAG      10 PHIF 0
GRUP 22 IBA1 10  WBIS   -   GFIX 99999 BETT 10 ORTG  45 T0 3 FAK1 1 IBAG      10 PHIF 0
GRUP 23 IBA1 10  WBIS   -   GFIX 99999 BETT 10 ORTG  45 T0 3 FAK1 1 IBAG      10 PHIF 0                       $GRUP 23 IBA1 10  WBIS  -    GFIX 99999 BETT 10 ORTG 45 T0 3 FAK1 1 IBAG    10 PHIF 0


$ CONCRETE el. ABOVE THE COLUMNS
$GRUP 41 IBA1 50  WBIS  -    GFIX 99999 BETT 10 ORTG  - T0 7 FAK1 1 IBAG    50 PHIF 0
$GRUP 42 IBA1 50  WBIS  -    GFIX 99999 BETT 10 ORTG  - T0 7 FAK1 1 IBAG    50 PHIF 0
$GRUP 43 IBA1 50  WBIS  -    GFIX 99999 BETT 10 ORTG  - T0 7 FAK1 1 IBAG    50 PHIF 0
GRUP 41 IBA1 43  WBIS   -   GFIX 99999 BETT 10 ORTG   - T0 7 FAK1 1 IBAG      43 PHIF 0
GRUP 42 IBA1 43  WBIS   -   GFIX 99999 BETT 10 ORTG   - T0 7 FAK1 1 IBAG      43 PHIF 0
GRUP 43 IBA1 43  WBIS   -   GFIX 99999 BETT 10 ORTG   - T0 7 FAK1 1 IBAG      43 PHIF 0


!CIPS Plate
GRUP 45 IBA1 50  WBIS   -   GFIX 99999 BETT 10 ORTG   - T0 7 FAK1 1 IBAG   99999 PHIF 0 QEMX 0.001 QUEA 0.001

!Support in the prefabrication plant
GRUP 90 IBA1 10  WBIS  40   GFIX 99999 BETT 10 ORTG   - T0 7 FAK1 1 IBAG   99999 PHIF 0                       !Support in the prefabrication plant
GRUP 91 IBA1 10  WBIS  14   GFIX 99999 BETT 10 ORTG   - T0 7 FAK1 1 IBAG   99999 PHIF 0                       !Support of PE 1.1 in prestressing bed

!SCAFFOLDING
$GRUP 95 IBA1 41  WBIS 50    GFIX 99999 BETT 10 ORTG  - T0 7 FAK1 1 IBAG 99999 PHIF 0   !Temporary support
GRUP 95 IBA1 41  WBIS  50   GFIX 99999 BETT 10 ORTG   - T0 7 FAK1 1 IBAG   99999 PHIF 0                       !Temporary support

!wall A10
GRUP 97 IBA1 42  WBIS   -   GFIX 99999 BETT 10 ORTG   - T0 7 FAK1 1 IBAG      42 PHIF 0                       !Support axis 10
!columns A20
GRUP 98 IBA1 42  WBIS   -   GFIX 99999 BETT 10 ORTG   - T0 7 FAK1 1 IBAG      42 PHIF 0                       !Support axis 20
$GRUP 98 IBA1 42  WBIS  -    GFIX 99999 BETT 42 ORTG  - T0 7 FAK1 1 IBAG 42 PHIF 0   !Support axis 20
!support A30
GRUP 96 IBA1 41  WBIS   -   GFIX 99999 BETT 10 ORTG   - T0 7 FAK1 1 IBAG   99999 PHIF 0                       !elastomeric bearing axis 30
$GRUP 96 IBA1 41  WBIS  -    GFIX 99999 BETT 10 ORTG  - T0 7 FAK1 1 IBAG 99999 PHIF 0   !elastomeric bearing axis 30
$GRUP 97 IBA1 50  WBIS  -    GFIX 99999 BETT 10 ORTG  - T0 7 FAK1 1 IBAG 50 PHIF 0   !Support axis 10
$GRUP 98 IBA1 50  WBIS  -    GFIX 99999 BETT 50 ORTG  - T0 7 FAK1 1 IBAG 50 PHIF 0   !Support axis 20

ENDE

+apply "$(NAME)_csm.dat"

!+!Chapter 05 Load tests reference phase
+PROG ASE urs:21
KOPF Linear-elastic w/o CSM

GRUP  - BA 998
GRUP 90 NEIN
GRUP 91 NEIN
GRUP 95 NEIN

GRP2 45 QEMX 0.001 QUEA 0.001      !Deactivate stiffness of plate elements in x-direction
  STEU SOLV
  STEU WARN 185,197,335,398,399
  LF 1
  LF 2
  LF 3
  LF 100
  LF (202 205 1)
  LF (301 360 1)
  LF 401
  LF 402

ENDE

+PROG ASE urs:13
KOPF Linear-elastic with CSM


GRUP 'CSM' BA 84

LOOP#i 4
    LF 1202+#i TYP None
        LC 202+#i
ENDLOOP

ENDE

-PROG ASE urs:22
KOPF Non-linear with CSM - LC 4084

SYST PROB TH3 ITER 100 PLF 4084
DEHN K1 KSV SL KSB SL
GRUP "CSM" BA 84 T1
GRUP 45 LINE BA 84

LF 2200 FAKG 1.0

ENDE

-PROG ASE urs:23
KOPF Non-linear with CSM - LC 202

SYST PROB NONL ITER 100
GRUP "CSM" BA 84
GRUP 45 LINE BA 84


LF 2202 FAKG 1.0
    LC 2200
    LC 202

DEHN S1 KSV SL KSB SL

ENDE


!+!Chapter 06 Load tests
-PROG ASE urs:17
KOPF
STEU WARN 70121
ECHO LAST EXTR
ECHO MAT EXTR
ECHO DEHN EXTR

SYST PROB NONL ITER 100
GRUP "CSM" BA 84
GRUP 45 LINE BA 84

LF 101 FAKG 1.0 BEZ 'copy of 4084'
    LC 4084

DEHN S1 KSV SL KSB SL

ENDE

-PROG ASE urs:18
KOPF
ECHO GRUP,LAST NEIN
STEU WARN 70121

SYST PROB NONL ITER 100
GRUP "CSM" BA 84
GRUP 45 LINE BA 84

LF 102 FAKG 1.0 BEZ 'copy of 4070'
    LC 4070

DEHN S1 KSV SL KSB SL

ENDE



-PROG ASE urs:14
KOPF Simulation of Load Test
ECHO LAST EXTR
ECHO MAT JA

STEU SOLV 4
TRAG 25 FAK1 0.0001 DFAK 0.5 PRO 1 DMIN -0.001 FAKE -0.001 EG NEIN PRIM NEIN SLOW 4
SYST PROB NONL ITER 100

GRUP "CSM" BA 84
GRUP 45 LINE BA 84

STEU WARN 282
STEU WARN 42

LF 301 FAKG 1.0  BEZ 'Überlastung'
    LC 4084 TRAG NEIN
    LC 100  TRAG JA     !only increase of the vertical loadL

DEHN S1 KSV SL KSB SL

ENDE
sto#lastultib #ASE_ITER(1)
ENDE

-PROG ASE urs:16
KOPF Load-displacement-curve x = 24.3 m
PLOT LF 301 KNR 1280 TYP FAKT RICH UZ NULL 0
ENDE


#include "$(NAME).results"
