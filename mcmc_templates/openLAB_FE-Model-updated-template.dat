!Definition Rail
#define schiene

   let#masse  54*(#xdavor/2+#xdanach/2)         !Mass of a rail (S54 profile with m= 54 kg/m) with half distance between previous and next sleeper as load application area
   let#GSchiene #masse*0.00981/((0.13+2*0.08)*(#breite+2*0.08))   !Dead load rail

   Let#x_1    #x-#breite/2-0.08
   Let#y_1    -0.685-0.13-0.08[m]

   Let#x_2    #x+#breite/2+0.08
   Let#y_2    -0.685-0.13-0.08[m]

   Let#x_3    #x+#breite/2+0.08
   Let#y_3    -0.685+0.08[m]

   Let#x_4    #x-#breite/2-0.08
   Let#y_4    -0.685+0.08[m]

   AREA REF QGRP NR 45 TYP PG P1 #GSchiene #x_1 #y_1     P2 #GSchiene #x_2 #y_2     P3 #GSchiene #x_3 #y_3     P4 #GSchiene #x_4  #y_4   !area rail 1
   AREA REF QGRP NR 45 TYP PG P1 #GSchiene #x_1 -#y_1    P2 #GSchiene #x_2 -#y_2    P3 #GSchiene #x_3 -#y_3    P4 #GSchiene #x_4  -#y_4  !area rail 2

#enddef

